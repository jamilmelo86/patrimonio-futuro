# Copie para .env e preencha o que tiver. Tudo é opcional:
# sem chaves, o pipeline ainda coleta via RSS e gera rascunhos-esqueleto.

# Ativa a reescrita editorial por IA (Claude Haiku). Sem isso, os rascunhos
# vêm como esqueletos para você escrever à mão.
ANTHROPIC_API_KEY=

# Modelo da Anthropic (opcional). Padrão: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Fontes extras (opcionais):
GUARDIAN_API_KEY=
NEWSDATA_API_KEY=

# Máximo de rascunhos gerados por execução (padrão 8)
MAX_DRAFTS=8

# Máximo de rascunhos por editoria numa mesma execução (padrão 3) — mantém o dia variado
MAX_POR_CATEGORIA=3

# Ignorar notícias mais antigas que N dias (padrão 45)
MAX_IDADE_DIAS=45

# Reaproveitar a imagem da fonte? Vazio/0 = não (recomendado, evita direitos autorais).
# Defina 1 para religar (só usa URLs que são imagem de verdade).
USAR_IMAGEM_FONTE=
