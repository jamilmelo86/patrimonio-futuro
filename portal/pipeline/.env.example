# Copie para .env e preencha o que tiver. Tudo é opcional:
# sem chaves, o pipeline ainda coleta via RSS e gera rascunhos-esqueleto.

# Ativa a reescrita editorial por IA (Claude Haiku). Sem isso, os rascunhos
# vêm como esqueletos para você escrever à mão.
ANTHROPIC_API_KEY=

# Modelo da Anthropic (opcional). Padrão: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Fontes extras (opcionais):
GUARDIAN_API_KEY=
NEWSDATA_API_KEY=

# Máximo de itens gerados por execução (padrão 8)
MAX_DRAFTS=8

# Publicar automaticamente (1, padrão) ou gerar rascunhos p/ revisão manual (0)
PUBLICAR_AUTOMATICO=1

# Confiança mínima (0 a 1) para a IA publicar sem revisão (padrão 0.7; workflow usa 0.72)
LIMIAR_CONFIANCA=0.72

# Robô revisor: máximo de publicações revisadas por execução (padrão 12)
MAX_REVISAR=12

# Imagens de licença livre (opcional): NASA e Openverse funcionam SEM chave.
# Para fotos melhores/mais relevantes, pegue uma chave grátis em pexels.com/api:
PEXELS_API_KEY=

# Máximo de rascunhos por editoria numa mesma execução (padrão 3) — mantém o dia variado
MAX_POR_CATEGORIA=3

# Ignorar notícias mais antigas que N dias (padrão 45)
MAX_IDADE_DIAS=45

# Reaproveitar a imagem da fonte? Vazio/0 = não (recomendado, evita direitos autorais).
# Defina 1 para religar (só usa URLs que são imagem de verdade).
USAR_IMAGEM_FONTE=
