---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { SITE, CATEGORIAS, categoriaPorSlug } from "../consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf(),
);

// Destaque que ALTERNA: gira diariamente entre as notícias mais recentes (com
// imagem). Assim a capa muda a cada dia em vez de ficar fixa na mesma história.
const recentes = posts.slice(0, 14);
const candidatos = recentes.filter((p) => p.data.imagem);
const pool = candidatos.length ? candidatos : recentes;
const diaAtual = Math.floor(Date.now() / 86_400_000); // dias desde a época
const destaque = pool.length ? pool[diaAtual % pool.length] : posts[0];
const ultimas = posts.filter((p) => p.id !== destaque?.id).slice(0, 12);

const catDestaque = destaque ? categoriaPorSlug(destaque.data.categoria) : undefined;
const dataDestaque = destaque
  ? destaque.data.data.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" })
  : "";
---
<BaseLayout>
  <div class="container">
    {posts.length === 0 ? (
      <p style="text-align:center;padding:64px 0;color:var(--muted)">
        Ainda não há notícias publicadas. Em breve, muitas boas novas por aqui!
      </p>
    ) : (
      <>
        {destaque && (
          <section class="destaque">
            <a href={`/noticia/${destaque.id}/`} class="thumb">
              {destaque.data.imagem ? (
                <img src={destaque.data.imagem} alt={destaque.data.titulo} />
              ) : (
                <div class="thumb-ph" style={`--ph:${catDestaque?.cor ?? "#fdf2d6"}`}>
                  <span class="emoji" style="font-size:4rem">{catDestaque?.emoji}</span>
                  <span class="brand-mark">{SITE.name}</span>
                </div>
              )}
            </a>
            <div>
              <a class="eyebrow" href={`/categoria/${destaque.data.categoria}/`}>
                {catDestaque?.nome} · Destaque
              </a>
              <h2><a href={`/noticia/${destaque.id}/`}>{destaque.data.titulo}</a></h2>
              <p class="resumo">{destaque.data.resumo}</p>
              <p class="meta">{dataDestaque}</p>
              <a class="btn" href={`/noticia/${destaque.id}/`}>Ler a história</a>
            </div>
          </section>
        )}

        <AdSlot />

        <div class="secao-titulo">
          <h2>Últimas boas notícias</h2>
          <a href="/rss.xml">Assinar RSS</a>
        </div>
        <div class="grid">
          {ultimas.map((post) => <PostCard post={post} />)}
        </div>

        <NewsletterSignup />

        <div class="secao-titulo">
          <h2>Explore por editoria</h2>
        </div>
        <div class="cat-grid">
          {CATEGORIAS.map((c) => (
            <a class="cat-card" href={`/categoria/${c.slug}/`}>
              <span class="emoji">{c.emoji}</span>
              <span><strong>{c.nome}</strong><span>{c.descricao}</span></span>
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>
