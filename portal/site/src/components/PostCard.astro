---
import { categoriaPorSlug, SITE } from "../consts";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { titulo, resumo, categoria, data, imagem } = post.data;
const cat = categoriaPorSlug(categoria);
const dataFmt = data.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
const href = `/noticia/${post.id}/`;
---
<article class="card">
  <a href={href} class="thumb" aria-label={titulo}>
    {imagem ? (
      <img src={imagem} alt={titulo} loading="lazy" />
    ) : (
      <div class="thumb-ph" style={`--ph:${cat?.cor ?? "#fdf2d6"}`}>
        <span class="emoji">{cat?.emoji ?? "📰"}</span>
        <span class="brand-mark">{SITE.name}</span>
      </div>
    )}
  </a>
  <div class="corpo">
    <a class="eyebrow" href={`/categoria/${categoria}/`}>{cat?.nome}</a>
    <h3><a href={href}>{titulo}</a></h3>
    <p class="resumo">{resumo}</p>
    <div class="meta">{dataFmt}</div>
  </div>
</article>
